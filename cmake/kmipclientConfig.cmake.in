@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Without components, FindOpenSSL only requires libcrypto, so a system
# lacking libssl would "find" OpenSSL yet have no OpenSSL::SSL target.
find_dependency(OpenSSL COMPONENTS SSL Crypto)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/kmipclientTargets.cmake")

check_required_components(kmipclient)
